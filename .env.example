# Vercel Deployment Token (optional for local dev)
VERCEL_ACCESS_TOKEN=your_vercel_access_token_here

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudflare TURN (recommended): Dashboard > Realtime > TURN Server > create key.
# Server-side secrets used by api/turn.js; deploy_vercel.ps1 syncs them to Vercel.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Alternative: static TURN relay for players behind VPNs (e.g. Cloudflare 1.1.1.1 / WARP) or strict NATs.
# Use a provider that listens on TLS/TCP 443 (Cloudflare Realtime TURN, Metered, Twilio...).
# Comma-separated URLs, e.g. turns:turn.example.com:443?transport=tcp,turn:turn.example.com:3478
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
